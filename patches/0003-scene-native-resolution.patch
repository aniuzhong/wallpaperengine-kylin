+void CScene::setupFramebuffers () {
+    // render the scene at the output resolution so high-dpi screens get a
+    // sharp image; the camera projection (world coordinates) is unchanged,
+    // only the pixel density of the render targets increases
+    const uint32_t width = this->getContext ().getOutput ().getFullWidth ();
+    const uint32_t height = this->getContext ().getOutput ().getFullHeight ();
+    const uint32_t clamp = this->getState ().getClampingMode ();
+
+    this->m_sceneFBO = this->create (
+	"_rt_FullFrameBuffer", TextureFormat_ARGB8888, clamp, 1.0, { width, height }, { width, height }
+    );
+
+    this->alias ("_rt_MipMappedFrameBuffer", "_rt_FullFrameBuffer");
+}
