+std::string ShaderUnit::applyFragmentVaryingInjection (std::string source) const {
+    // wallpapers authored for WE may consume vertex varyings in the fragment
+    // stage without declaring them (the original compiler forwards varyings
+    // between stages automatically); re-declare the missing ones so the
+    // fragment unit compiles
+    fprintf (stderr, "[inj] frag unit entered, link=%p\n", (void*) this->m_link);
+    if (this->m_type != GLSLContext::UnitType_Fragment || this->m_link == nullptr) {
+	return source;
+    }
+
+    static const std::regex vertexVaryingDecl (R"(\bvarying\s+(\w+)\s+(\w+)\s*;)");
+    std::string linked = this->m_link->m_preprocessed;
+
+    std::string missing;
+    for (std::sregex_iterator it = std::sregex_iterator (linked.begin (), linked.end (), vertexVaryingDecl);
+         it != std::sregex_iterator (); it++) {
+	const std::string type = (*it)[1].str ();
+	const std::string name = (*it)[2].str ();
+
+	const std::regex declared ("\\b(varying|uniform|attribute)\\s+" + type + "\\s+" + name + "\\b");
+	if (std::regex_search (source, declared)) {
+	    continue;
+	}
+
+	const std::regex used ("\\b" + name + "\\b");
+	if (!std::regex_search (source, used)) {
+	    continue;
+	}
+
+	missing += "varying " + type + " " + name + ";\n";
+    }
+
+    if (!missing.empty ()) {
+	const size_t position = source.find ("void main");
+	if (position != std::string::npos) {
+	    source.insert (position, missing);
+	}
+    }
+
+    return source;
+}
