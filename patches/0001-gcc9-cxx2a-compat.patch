+void GLFWOpenGLDriver::promoteToDesktopWindow () {
+#ifdef ENABLE_X11
+    // turn the GLFW window into a desktop-layer window: the compositor keeps
+    // it below everything else, and translucent desktop shells (peony-qt-desktop
+    // under ukui-kwin, etc.) show it through as the live wallpaper
+    glfwWindowHint (GLFW_FLOATING, GLFW_FALSE);
+
+    Display* display = XOpenDisplay (nullptr);
+    if (display == nullptr) {
+	sLog.error ("promoteToDesktopWindow: cannot open X display, window stays hidden");
+	return;
+    }
+
+    const Window window = glfwGetX11Window (this->m_window);
+
+    // desktop window type -> compositor's desktop layer (below everything)
+    Atom windowTypeAtom = XInternAtom (display, "_NET_WM_WINDOW_TYPE", False);
+    Atom desktopAtom = XInternAtom (display, "_NET_WM_WINDOW_TYPE_DESKTOP", False);
+    XChangeProperty (display, window, windowTypeAtom, XA_ATOM, 32, PropModeReplace,
+		     reinterpret_cast<const unsigned char*> (&desktopAtom), 1);
+
+    // keep below, never take focus
+    Atom stateAtom = XInternAtom (display, "_NET_WM_STATE", False);
+    Atom belowAtom = XInternAtom (display, "_NET_WM_STATE_BELOW", False);
+    XChangeProperty (display, window, stateAtom, XA_ATOM, 32, PropModeReplace,
+		     reinterpret_cast<const unsigned char*> (&belowAtom), 1);
+
+    XWMHints hints {};
+    hints.flags = InputHint;
+    hints.input = False;
+    XSetWMHints (display, window, &hints);
+
+    XSync (display, False);
+    XCloseDisplay (display);
+
+    // map the window (GLFW created it hidden)
+    this->showWindow ();
+#else
+    sLog.error ("promoteToDesktopWindow: not built with X11 support");
+#endif /* ENABLE_X11 */
+}
