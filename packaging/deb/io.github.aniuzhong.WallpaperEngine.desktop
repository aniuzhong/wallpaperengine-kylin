[Desktop Entry]
Type=Application
Version=1.0
Name=Wallpaper Engine
Name[zh_CN]=壁纸引擎
GenericName=Dynamic Wallpaper
GenericName[zh_CN]=动态壁纸
Comment=Browse and apply Wallpaper Engine wallpapers
Comment[zh_CN]=浏览并应用 Wallpaper Engine 壁纸
Exec=/opt/wallpaper-engine/bin/wallpaper-engine ui
TryExec=/opt/wallpaper-engine/bin/wallpaper-engine
Icon=wallpaper-engine
Terminal=false
Categories=Utility;DesktopSettings;
Keywords=wallpaper;background;desktop;
Keywords[zh_CN]=壁纸;桌面;背景;
