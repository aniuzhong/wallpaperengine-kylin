// Generated by cmake from src/ui/index.html, src/ui/style.css and
// src/ui/app.js. Edit those; this file is written into the build tree on
// every configure.
#include "uiassets.h"

namespace Ui {

std::string indexHtml() { return std::string(R"UIASSET(@UI_INDEX_HTML@)UIASSET"); }
std::string styleCss() { return std::string(R"UIASSET(@UI_STYLE_CSS@)UIASSET"); }
std::string appJs() { return std::string(R"UIASSET(@UI_APP_JS@)UIASSET"); }

} // namespace Ui
